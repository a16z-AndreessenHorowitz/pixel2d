pragma solidity ^0.8.24;

import "@openzeppelin/contracts/token/ERC20/ERC20.sol";
import "@openzeppelin/contracts/access/AccessControl.sol";
import "@openzeppelin/contracts/utils/ReentrancyGuard.sol";
import "@openzeppelin/contracts/utils/cryptography/ECDSA.sol";
import "@openzeppelin/contracts/utils/cryptography/EIP712.sol";

/**
 * @title PixelFarmToken
 * @dev ERC-20 token ($PIXEL) for Pixel2D GameFi.
 * Features:
 * - EIP-712 ECDSA backend cryptographic signature claims with domain separation
 *   (bound to chainId & verifyingContract to prevent cross-chain/cross-contract replay)
 * - Anti-replay attack protection via unique transaction nonces
 * - Configurable deadline, claim cap, and cooldown
 * - Development and testnet daily faucet
 * - Events for backend on-chain deposit, claim and withdrawal monitoring
 */
contract PixelFarmToken is ERC20, AccessControl, ReentrancyGuard, EIP712 {
    bytes32 public constant SIGNER_ROLE = keccak256("SIGNER_ROLE");

    // EIP-712 TypeHash for ClaimFarmingReward
    bytes32 public constant CLAIM_TYPEHASH =
        keccak256("ClaimFarmingReward(address player,uint256 amount,uint256 nonce,uint256 deadline)");

    // Replay attack prevention: mapping from nonce to consumed status
    mapping(uint256 => bool) public usedNonces;

    // Cooldown trackers
    mapping(address => uint256) public lastClaimAt;
    mapping(address => uint256) public lastFaucetAt;

    // Security constraints (1 In-Game Coin = 1 $PIXEL)
    uint256 public maxClaimCap = 100; // max 100 coins per claim transaction
    uint256 public cooldownSeconds = 300; // 5 minutes cooldown
    uint256 public faucetAmount = 100 * 10 ** 18; // 100 $PIXEL
    uint256 public faucetCooldown = 3600; // 1 hour cooldown for demo/testing

    // Events for Backend and Indexer tracking
    event RewardClaimed(address indexed player, uint256 amount, uint256 nonce);
    event FaucetClaimed(address indexed player, uint256 amount);
    event TokensDeposited(address indexed player, address indexed vault, uint256 amount, uint256 nonce);
    event ClaimCapUpdated(uint256 oldCap, uint256 newCap);
    event CooldownUpdated(uint256 oldCooldown, uint256 newCooldown);

    constructor(
        address defaultAdmin,
        address backendSigner
    ) ERC20("Pixel Farm Token", "PIXEL") EIP712("PixelFarmToken", "1") {
        require(defaultAdmin != address(0), "Admin cannot be zero address");
        require(backendSigner != address(0), "Signer cannot be zero address");

        _grantRole(DEFAULT_ADMIN_ROLE, defaultAdmin);
        _grantRole(SIGNER_ROLE, backendSigner);

        // Mint initial liquidity / reward pool to admin (10,000 $PIXEL)
        _mint(defaultAdmin, 10000 * 10 ** decimals());
    }

    /**
     * @notice Claim in-game farming coins as on-chain $PIXEL tokens using an EIP-712 Backend signature.
     * @param amount Number of In-Game Coins to convert (1 Coin = 1 $PIXEL)
     * @param nonce Unique nonce generated by Backend to prevent replay attacks
     * @param deadline Unix timestamp after which signature expires
     * @param signature EIP-712 signature signed by authorized server private key
     */
    function claimFarmingReward(
        uint256 amount,
        uint256 nonce,
        uint256 deadline,
        bytes calldata signature
    ) external nonReentrant {
        require(block.timestamp <= deadline, "Claim signature has expired");
        require(!usedNonces[nonce], "Nonce already used");
        require(amount > 0, "Amount must be greater than zero");
        require(amount <= maxClaimCap, "Amount exceeds max claim cap");
        require(
            block.timestamp >= lastClaimAt[msg.sender] + cooldownSeconds,
            "Claim cooldown is active"
        );

        // 1. Verify EIP-712 Typed Data Signature
        bytes32 structHash = keccak256(
            abi.encode(CLAIM_TYPEHASH, msg.sender, amount, nonce, deadline)
        );
        bytes32 digest = _hashTypedDataV4(structHash);
        address recoveredSigner = ECDSA.recover(digest, signature);
        require(hasRole(SIGNER_ROLE, recoveredSigner), "Invalid backend signature");

        // 2. Mark nonce as consumed & update cooldown
        usedNonces[nonce] = true;
        lastClaimAt[msg.sender] = block.timestamp;

        // 3. Mint $PIXEL to player (1 Coin = 1 * 10^18 token units)
        uint256 tokenUnits = amount * 10 ** decimals();
        _mint(msg.sender, tokenUnits);

        emit RewardClaimed(msg.sender, amount, nonce);
    }

    /**
     * @notice Daily testnet faucet to give players 100 $PIXEL for easy testing.
     */
    function claimFaucet() external nonReentrant {
        require(
            block.timestamp >= lastFaucetAt[msg.sender] + faucetCooldown,
            "Faucet cooldown is active"
        );

        lastFaucetAt[msg.sender] = block.timestamp;
        _mint(msg.sender, faucetAmount);

        emit FaucetClaimed(msg.sender, faucetAmount);
    }

    /**
     * @notice Helper deposit function that transfers tokens from player to system vault and emits an indexed event.
     * @param vault Address of the backend treasury vault
     * @param amount Number of tokens in wei
     * @param nonce Client/backend unique deposit nonce for tracking
     */
    function depositToVault(
        address vault,
        uint256 amount,
        uint256 nonce
    ) external nonReentrant {
        require(vault != address(0), "Vault cannot be zero address");
        require(amount > 0, "Amount must be greater than zero");

        _transfer(msg.sender, vault, amount);
        emit TokensDeposited(msg.sender, vault, amount, nonce);
    }

    // --- Admin Configuration ---

    function setMaxClaimCap(uint256 newCap) external onlyRole(DEFAULT_ADMIN_ROLE) {
        require(newCap > 0, "Cap must be greater than zero");
        emit ClaimCapUpdated(maxClaimCap, newCap);
        maxClaimCap = newCap;
    }

    function setCooldownSeconds(uint256 newCooldown) external onlyRole(DEFAULT_ADMIN_ROLE) {
        emit CooldownUpdated(cooldownSeconds, newCooldown);
        cooldownSeconds = newCooldown;
    }

    function setFaucetCooldown(uint256 newCooldown) external onlyRole(DEFAULT_ADMIN_ROLE) {
        faucetCooldown = newCooldown;
    }

    function setFaucetAmount(uint256 newAmount) external onlyRole(DEFAULT_ADMIN_ROLE) {
        faucetAmount = newAmount;
    }
}
